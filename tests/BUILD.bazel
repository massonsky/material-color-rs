load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools/bazel:python_extension_test.bzl", "python_extension_test")
load("//tools/bazel:scaffold_test.bzl", "scaffold_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "fixtures",
    srcs = glob([
        "compatibility/**",
        "fixtures/**",
        "golden/**",
    ]),
)

scaffold_test(
    name = "scaffold_smoke_test",
    data = [
        "//:workspace_files",
        "//crates/material_color:srcs",
    ],
)

cc_test(
    name = "cpp_integration_smoke_test",
    srcs = ["cpp/material_color_cpp_smoke.cc"],
    deps = ["//bindings/cpp:material_color_cpp"],
)

python_extension_test(
    name = "python_import_smoke_test",
    extension = "//crates/material_color_py:material_color_py_extension",
    script = "python/material_color_py_smoke.py",
)

python_extension_test(
    name = "python_golden_compatibility_test",
    data = [":fixtures"],
    extension = "//crates/material_color_py:material_color_py_extension",
    script = "compatibility/material_color_golden.py",
)
